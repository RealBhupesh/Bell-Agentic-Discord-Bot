# Bell environment template.
#
# Copy to .env and fill in the secrets:   cp .env.example .env
# .env is git-ignored. Never commit real tokens, keys or database URLs.
#
# Every value below is a safe default. Anything that makes the bot act on its own
# (automation, proactive posts, AI moderation) is OFF here. Unset variables fall back
# to the defaults in the code; where the code default differs from this template it is
# noted as "code default: ...".
# Booleans accept 1/true/yes/on (anything else is false).

# =============================================================================
# Discord
# =============================================================================
# Bot token from the Discord Developer Portal (Bot -> Reset Token). REQUIRED.
# Note: the variable is DISCORD_BOT_TOKEN (not DISCORD_TOKEN).
DISCORD_BOT_TOKEN=
# Command prefix.
BOT_PREFIX=&
# "Playing ..." status text.
BOT_ACTIVITY_TEXT=with your crush
# Sync slash (/) commands with Discord on start.
SYNC_SLASH_COMMANDS=true
# Presence intent (privileged; also enable it in the portal). Only used by the alt-finder and social stats.
DISCORD_ENABLE_PRESENCE_INTENT=false

# =============================================================================
# AI provider
# =============================================================================
# groq (recommended: protected by the budget governor) or openrouter.
# If unset, groq is picked when only GROQ_API_KEY is set, otherwise openrouter.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_API_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODELS_URL=https://api.groq.com/openai/v1/models

# OpenRouter (alternative). NOT covered by the Groq budget governor's daily budgets.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemma-3-4b-it:free
OPENROUTER_FALLBACK_MODELS=google/gemma-3-4b-it:free,qwen/qwen3-4b:free,deepseek/deepseek-r1-0528:free
OPENROUTER_API_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODELS_URL=https://openrouter.ai/api/v1/models
OPENROUTER_APP_NAME=Discord Mod Bot
OPENROUTER_HTTP_REFERER=

# -----------------------------------------------------------------------------
# Groq model chains (free-tier models only)
# -----------------------------------------------------------------------------
# Primary model, then fallbacks tried in order on HTTP 429 / exhausted budget.
GROQ_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# Feature-specific chains (same free-tier defaults).
ALTFINDER_RANK_MODEL=openai/gpt-oss-120b
ALTFINDER_EXPLAIN_MODEL=openai/gpt-oss-120b
ALTFINDER_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
SOCIALINTEL_RANK_MODEL=openai/gpt-oss-120b
SOCIALINTEL_EXPLAIN_MODEL=openai/gpt-oss-120b
SOCIALINTEL_FALLBACK_MODELS=openai/gpt-oss-20b,qwen/qwen3.8-27b
# AI moderation model overrides (empty = use the normal chain).
AI_MOD_FAST_MODEL=
AI_MOD_JUDGE_MODEL=
# Paid-tier (Enterprise/Developer) Groq models are stripped from every chain above
# unless this is 1. Keep 0 to stay on the free tier.
GROQ_ALLOW_ENTERPRISE_MODELS=0

# =============================================================================
# Budget governor (Groq) and per-feature caps
# =============================================================================
# Per-model limits. Defaults are Groq's published free-tier numbers (from Groq's public
# docs, not verified against your key). Lower them if your account's limits are stricter.
GROQ_LIMIT_RPM=30
GROQ_LIMIT_RPD=1000
GROQ_LIMIT_TPM=8000
GROQ_LIMIT_TPD=200000
# Per-model overrides: model=rpm:rpd:tpm:tpd;other-model=...
GROQ_MODEL_LIMITS=
# Per-feature daily request caps: feature=n,feature=n (overrides the *_DAILY_CAP values below).
GROQ_FEATURE_DAILY_CAPS=
# Cap for features without their own cap. 0 = unlimited.
GROQ_FEATURE_DAILY_CAP_DEFAULT=0
# Longest wait in the FIFO queue for a minute budget before refusing.
GROQ_BUDGET_MAX_WAIT_SECONDS=20
# Back-off when a 429 has no Retry-After header.
GROQ_DEFAULT_RETRY_AFTER_SECONDS=60
# Maximum queued requests.
GROQ_QUEUE_MAX=100
# Counter file for the JSON backend. Empty = data/groq_budget_state.json.
GROQ_BUDGET_STATE_FILE=

# Feature caps (requests per UTC day).
# &agent requests per user per day (enforced by agent_core).
AGENT_DAILY_CAP=20
AGENT_MAX_TOKENS=500
# Crush-o-Meter plays, and its optional AI joke line (Groq only).
CRUSH_GAME_DAILY_CAP=50
CRUSH_GAME_FLAVOR_DAILY_CAP=50
# Agentic automation, shared across all servers.
AGENTIC_SCHEDULED_DAILY_CAP=50
AGENTIC_ESCALATION_DAILY_CAP=50
AGENTIC_NUDGE_DAILY_CAP=100

# =============================================================================
# Storage
# =============================================================================
# Empty/unset = JSON files under data/ (the default). Set to a postgresql:// URL only after
# running db/migrate_json_to_postgres.py (see docs/DEPLOYMENT.md). The Postgres backend has
# only been tested against fakes, never a live hosted database. Never commit the real value.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DBNAME

# =============================================================================
# Automation and proactive features (all OFF)
# =============================================================================
# Agentic automation (scheduled tasks, escalation proposals, nudges) has no env switch:
# it is off until a server enables it with &agentic (Manage Server).
#
# Proactive engagement posts in the hub channel. Per-server toggle overrides this.
AUTO_LOOPS_ENABLED=false
AUTO_LOOP_MAX_POSTS_PER_HOUR=3
AUTO_LOOP_HUB_CHANNEL_ONLY=true
# Proactively revive quiet threads.
THREADREVIVE_PROACTIVE_ENABLED=false
THREADREVIVE_PROACTIVE_MIN_IDLE_MINUTES=180
THREADREVIVE_PROACTIVE_COOLDOWN_SECONDS=21600
# AI welcome DM to new members. Per-server toggle overrides this. (code default: true)
WELCOME_CONCIERGE_ENABLED=false
WELCOME_DM_TIMEOUT_MINUTES=1440
WELCOME_RECOMMENDATION_COUNT=5
WELCOME_INTEREST_MAX_CHARS=240
# Periodic AI "market director" that tunes the economy within bounded ranges. (code default: true)
BUSINESS_AI_TUNING_ENABLED=false
BUSINESS_AI_DIRECTOR_INTERVAL_HOURS=3

# =============================================================================
# Moderation
# =============================================================================
# Fallback mod-log channel id if &setmodlog is not used.
MOD_LOG_CHANNEL_ID=
# AutoMod default for servers that have not run &automod.
AUTOMOD_ENABLED=false
AUTOMOD_BLOCK_LINKS=true
AUTOMOD_SPAM_MSG_THRESHOLD=6
AUTOMOD_SPAM_INTERVAL_SECONDS=8
AUTOMOD_SPAM_TIMEOUT_MINUTES=5
# AI moderation guard default for servers that have not configured it.
AI_MOD_ENABLED=false
AI_MOD_SHADOW_DAYS=7
AI_MOD_RETENTION_DAYS=30
AI_MOD_MAX_CASES=6000
STRIKE_DECAY_DAYS=7
MOD_HEAT_THRESHOLD=0.72
MOD_HEAT_SLOWMODE_SECONDS=20

# =============================================================================
# General AI tuning
# =============================================================================
AI_MAX_HISTORY=4
AI_MAX_TOKENS=260
AI_SUMMARY_MAX_TOKENS=320
AI_TIMEOUT_SECONDS=45
AI_MAX_INFLIGHT=3
AI_RETRY_BACKOFF_SECONDS=1.2
AI_CIRCUIT_BREAK_SECONDS=45
# Rate limits for fun AI commands.
FUN_USER_RATE_WINDOW_SECONDS=45
FUN_USER_RATE_MAX_CALLS=3
FUN_CHANNEL_RATE_WINDOW_SECONDS=20
FUN_CHANNEL_RATE_MAX_CALLS=4

# Supportive-listener mode.
PSYCH_SESSION_TIMEOUT_MINUTES=1440
PSYCH_MAX_TOKENS=320
PSYCH_MAX_NOTES_CHARS=1200
PSYCH_MAX_TURNS=60
PSYCH_CRISIS_STRICT=true
PSYCH_LISTEN_WINDOW_SECONDS=12
PSYCH_SOLUTION_TRIGGER_MODE=explicit
PSYCH_MAX_BUFFERED_MESSAGES=25
# &argument mode.
ARGUMENT_MODE_MAX_TURNS=14
ARGUMENT_MODE_TIMEOUT_MINUTES=45
ARGUMENT_MODE_REPLY_TOKENS=180

# &vibe / &myvibe (reads recent messages in the current channel on demand).
VIBE_DEFAULT_MESSAGE_COUNT=200
VIBE_MAX_MESSAGE_COUNT=800
VIBE_MIN_REQUIRED_MESSAGES=25
VIBE_MAX_PROMPT_MESSAGES=80
VIBE_MAX_PROMPT_CHARS=12000

# History-scan tuning shared by &roast's server-wide message window and the alt-finder /
# social stats backfills. (AICRUSH_* names are historical; the old history-mining crush
# command is gone and the crush game never scans history.)
AICRUSH_SCAN_PER_CHANNEL=450
# 0 = scan all visible text channels.
AICRUSH_MAX_CHANNELS=0
AICRUSH_FULL_HISTORY_SCAN=true
AICRUSH_MAX_HISTORY_MESSAGES=12000
AICRUSH_SCAN_PAUSE_EVERY=260
AICRUSH_SCAN_PAUSE_SECONDS=0.12
AICRUSH_CACHE_SECONDS=900
AICRUSH_CHANNEL_RECENT_WINDOW_SECONDS=21600
ROAST_FULL_HISTORY_SCAN=true
ROAST_SCAN_PER_CHANNEL=350
ROAST_MAX_CHANNELS=0
ROAST_MAX_HISTORY_MESSAGES=8000
ROAST_SCAN_PAUSE_EVERY=240
ROAST_SCAN_PAUSE_SECONDS=0.08
ROAST_MAX_CONTEXT_CHARS=14000
ROAST_CACHE_SECONDS=900
ROAST_REPEAT_COOLDOWN_HOURS=12
ANALYZE_CACHE_SECONDS=300

# &catchup and &serverinsights.
CATCHUP_MAX_HOURS=168
CATCHUP_MAX_MESSAGES=1200
CATCHUP_SCAN_LIMIT=2500
CATCHUP_CACHE_SECONDS=120
CATCHUP_MAX_PROMPT_CHARS=12000
INSIGHTS_MAX_HOURS=336
INSIGHTS_MAX_CHANNELS=40
INSIGHTS_MAX_MESSAGES=12000
INSIGHTS_SCAN_PER_CHANNEL=900
INSIGHTS_CACHE_SECONDS=600

# Alt-account finder (moderator tool).
ALTFINDER_STATE_FLUSH_SECONDS=30
ALTFINDER_BACKFILL_MESSAGE_BUDGET=3200
ALTFINDER_BACKFILL_TIME_BUDGET_SECONDS=10
ALTFINDER_COMMAND_MAX_BACKFILL_MESSAGES=14000
ALTFINDER_COMMAND_MAX_BACKFILL_SECONDS=32
ALTFINDER_CACHE_SECONDS=900
ALTFINDER_MAX_RESULTS=5
# Social interaction stats.
SOCIALINTEL_STATE_FLUSH_SECONDS=30
SOCIALINTEL_BACKFILL_MESSAGE_BUDGET=3200
SOCIALINTEL_BACKFILL_TIME_BUDGET_SECONDS=10
SOCIALINTEL_COMMAND_MAX_BACKFILL_MESSAGES=14000
SOCIALINTEL_COMMAND_MAX_BACKFILL_SECONDS=32
SOCIALINTEL_CACHE_SECONDS=900
SOCIALINTEL_MAX_RESULTS=5

# =============================================================================
# Engagement
# =============================================================================
ENGAGEMENT_ENABLED=true
ENGAGEMENT_STATE_FLUSH_SECONDS=30
XP_MIN_MESSAGE_CHARS=15
XP_MESSAGE_COOLDOWN_SECONDS=45
XP_DAILY_CAP=220
STREAK_GRACE_HOURS=36
QUEST_DAILY_COUNT=3
EVENT_DEFAULT_DURATION_MINUTES=10
# Natural-language triggers for engagement commands in chat.
NL_ENGAGEMENT_TRIGGERS=true

# =============================================================================
# Economy (Business Empire)
# =============================================================================
BUSINESS_ENABLED=true
BUSINESS_STATE_FLUSH_SECONDS=30
# true = one economy shared by every server the bot is in.
BUSINESS_GLOBAL_MODE=true
BUSINESS_STARTER_CASH=10000
BUSINESS_DAILY_CLAIM=1500
BUSINESS_DAILY_CLAIM_STREAK_BONUS=250
BUSINESS_HOURLY_INTEREST_RATE=0.0012
BUSINESS_LOAN_GRACE_HOURS=24
BUSINESS_MAX_DEBT_TO_NETWORTH=1.8
BUSINESS_STOCK_COUNT=16
BUSINESS_MARKET_EVENT_CHANCE=0.18
BUSINESS_TRANSACTION_FEE_RATE=0.01
BUSINESS_PROPERTY_MAINTENANCE_RATE=0.004
BUSINESS_PROPERTY_TAX_RATE=0.006
BUSINESS_AUCTION_SNIPING_WINDOW_SECONDS=30
BUSINESS_AUCTION_SNIPING_EXTEND_SECONDS=60
BUSINESS_MAX_OPEN_TRADES=5
BUSINESS_MAX_OPEN_AUCTIONS=3
BUSINESS_COMMAND_COOLDOWN_SECONDS=3
BUSINESS_LEDGER_MAX_ENTRIES=50000
# One-line AI strategy tips in business commands (on-demand, cached).
BUSINESS_AI_PERSONALIZATION_ENABLED=true
BUSINESS_AI_MAX_TOKENS=140
BUSINESS_AI_PERSONALIZATION_CACHE_SECONDS=900
BUSINESS_SCHEMA_VERSION=2
BUSINESS_MARKET_TICK_MINUTES=15
BUSINESS_WORLD_EVENT_INTERVAL_MINUTES=120
BUSINESS_WEEKLY_CYCLE_DAYS=7
BUSINESS_EVENT_MAX_PER_DAY=6
BUSINESS_ENABLE_COMMODITIES=true
BUSINESS_ENABLE_CRYPTO=true
BUSINESS_ENABLE_PRIVATE_BUSINESSES=true
BUSINESS_CIRCUIT_BREAKER_DROP_PCT=25
BUSINESS_MARKET_HALT_DROP_PCT=15
BUSINESS_CAPITAL_GAINS_SHORT_RATE=0.15
BUSINESS_CAPITAL_GAINS_LONG_RATE=0.10
BUSINESS_CAPITAL_GAINS_LONG_HOLD_DAYS=7
BUSINESS_INCOME_TAX_ENABLED=true

# =============================================================================
# Music
# =============================================================================
FFMPEG_PATH=ffmpeg
MUSIC_MAX_PLAYLIST_ITEMS=50
VOICE_CONNECT_RETRIES=4
VOICE_CONNECT_TIMEOUT=25
VOICE_INTERNAL_RECONNECT=false
# Needed only for Spotify links (playlists must be public).
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# =============================================================================
# Small public APIs used by fun commands
# =============================================================================
CAT_API_URL=https://api.thecatapi.com/v1/images/search
MEALDB_BASE_URL=https://www.themealdb.com/api/json/v1/1
MEAL_CACHE_TTL_SECONDS=1800
